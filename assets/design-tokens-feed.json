{
  "_meta": {
    "project": "Wove.group",
    "version": "0.2-feed",
    "status": "Synced to assets/css/feed.css (the --feed-* custom properties), including the 2026-09-16 legibility pass",
    "exported": "2026-09-24",
    "basedOn": "assets/design-tokens.json v0.3",
    "notes": "assets/css/feed.css is the source; keep this file in sync with it by hand. Values below are the base (mobile-first) tokens; 'responsive' lists the overrides at 1280px and up. Weight 400 is the default for titles, body and chips; 600 only for uppercase labels and format badges."
  },
  "color": {
    "_note": "Dark palette (default). Light palette in colorLight, applied 7am–7pm via data-theme=\"light\".",
    "bg": "#131310",
    "surface": "#1b1b17",
    "surfaceRaised": "#22221d",
    "border": "#2a2a22",
    "textPrimary": "#f5f4ef",
    "textBody": "#fefdfb",
    "textMuted": "#b0ab9f",
    "textDim": "#847f73",
    "textInverse": "#131310",
    "coral": "#ed8c7c",
    "gold": "#e8c888",
    "green": "#9cd3b7",
    "blue": "#c7d0fa",
    "purple": "#c7b4ee",
    "accentBlue": "#2a50f3",
    "accentGreen": "#2f7a57",
    "white": "#ffffff",
    "white85": "rgba(255,255,255,0.85)",
    "white80": "rgba(255,255,255,0.80)",
    "white50": "rgba(255,255,255,0.50)",
    "white16": "rgba(255,255,255,0.16)",
    "borderSubtle": "rgba(255,255,255,0.06)",
    "rule": "rgba(255,255,255,0.08)"
  },
  "colorLight": {
    "_note": "Light palette, [data-theme=\"light\"] .feed-wrap",
    "bg": "#f5f4f0",
    "surface": "#ffffff",
    "surfaceRaised": "#eeeee9",
    "border": "#ddddd5",
    "borderSubtle": "rgba(0,0,0,0.06)",
    "rule": "rgba(0,0,0,0.08)",
    "textPrimary": "#1b1b17",
    "textBody": "#0e0e0b",
    "textMuted": "#555148",
    "textDim": "#847f73",
    "textInverse": "#f1efe8",
    "coral": "#c9543f",
    "gold": "#b08a30",
    "green": "#3a8e64",
    "blue": "#4a5ab8",
    "purple": "#7b5db8"
  },
  "typography": {
    "fontFamily": "Ballinger",
    "fallback": "sans-serif",
    "fontWeight": {
      "light": 300,
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "styles": {
      "feedH1": {
        "use": "Feed page title (e.g. 'Latest from the studio')",
        "px": 36,
        "rem": "2.25rem",
        "weight": 400,
        "lineHeight": 1.2,
        "letterSpacing": "-0.02em",
        "cssVar": "--feed-fs-h1"
      },
      "feedH2": {
        "use": "Section titles (e.g. 'Sparks', 'Threads')",
        "px": 22,
        "rem": "1.375rem",
        "weight": 400,
        "lineHeight": 1.2,
        "letterSpacing": "-0.01em",
        "cssVar": "--feed-fs-h2"
      },
      "railBrand": {
        "use": "Brand name in facet rail",
        "px": 22,
        "rem": "1.375rem",
        "weight": 400,
        "lineHeight": 1.2,
        "letterSpacing": "-0.01em",
        "cssVar": "--feed-fs-rail-brand"
      },
      "railItem": {
        "use": "Service area names in facet rail",
        "px": 18,
        "rem": "1.125rem",
        "weight": 400,
        "lineHeight": 1.3,
        "letterSpacing": "-0.01em",
        "cssVar": "--feed-fs-rail-item"
      },
      "cardTitle": {
        "use": "Article/entry card title",
        "px": 18,
        "rem": "1.125rem",
        "weight": 400,
        "lineHeight": 1.3,
        "letterSpacing": "-0.01em",
        "cssVar": "--feed-fs-card-title"
      },
      "cardBody": {
        "use": "Spark quote text — body IS the card",
        "px": 18,
        "rem": "1.125rem",
        "weight": 400,
        "lineHeight": 1.3,
        "letterSpacing": "-0.005em",
        "cssVar": "--feed-fs-card-title"
      },
      "cardExcerpt": {
        "use": "Card excerpt/summary (What if, Long read)",
        "px": 14,
        "rem": "0.875rem",
        "weight": 400,
        "lineHeight": 1.6,
        "letterSpacing": 0,
        "cssVar": "--feed-fs-excerpt"
      },
      "cardMeta": {
        "use": "Byline — author name, date",
        "px": 13,
        "rem": "0.8125rem",
        "weight": 400,
        "lineHeight": 1.6,
        "letterSpacing": 0,
        "cssVar": "--feed-fs-meta"
      },
      "formatLabel": {
        "use": "SPARK, THREAD, WHAT IF, LONG READ badge",
        "px": 11,
        "rem": "0.6875rem",
        "weight": 600,
        "lineHeight": 1.6,
        "letterSpacing": "0.08em",
        "textTransform": "uppercase",
        "cssVar": "--feed-fs-format"
      },
      "sectionLabel": {
        "use": "Uppercase group labels (SERVICE AREAS, TOPICS, 01 · CAROUSEL)",
        "px": 12,
        "rem": "0.75rem",
        "weight": 600,
        "lineHeight": 1.6,
        "letterSpacing": "0.08em",
        "textTransform": "uppercase",
        "cssVar": "--feed-fs-label"
      },
      "body": {
        "use": "Default body/paragraph text",
        "px": 15,
        "rem": "0.9375rem",
        "weight": 400,
        "lineHeight": 1.6,
        "letterSpacing": 0,
        "cssVar": "--feed-fs-body"
      },
      "nav": {
        "use": "Navigation links",
        "px": 16,
        "rem": "1rem",
        "weight": 500,
        "lineHeight": 1.0,
        "letterSpacing": 0,
        "cssVar": "--feed-fs-nav"
      },
      "chip": {
        "use": "Filter chips / tag buttons",
        "px": 13,
        "rem": "0.8125rem",
        "weight": 400,
        "lineHeight": 1.0,
        "letterSpacing": 0,
        "cssVar": "--feed-fs-chip"
      },
      "count": {
        "use": "Entry counts next to service areas",
        "px": 13,
        "rem": "0.8125rem",
        "weight": 400,
        "lineHeight": 1.3,
        "letterSpacing": 0,
        "cssVar": "--feed-fs-meta"
      },
      "cardTag": {
        "px": 12,
        "rem": "0.75rem",
        "weight": 400,
        "lineHeight": 1.3,
        "letterSpacing": 0,
        "cssVar": "--feed-fs-tag",
        "use": "Card tags and small links under cards (added 2026-09-24)"
      },
      "avatarInitials": {
        "px": 9,
        "rem": "0.5625rem",
        "weight": 600,
        "lineHeight": 1.0,
        "letterSpacing": 0,
        "cssVar": "--feed-fs-avatar",
        "use": "Initials in the 20px byline avatar (added 2026-09-24)"
      },
      "hero": {
        "use": "Homepage hero title",
        "px": 44,
        "rem": "2.75rem",
        "weight": 400,
        "lineHeight": 1.1,
        "letterSpacing": "-0.02em",
        "cssVar": "--feed-fs-hero"
      }
    },
    "lineHeight": {
      "body": 1.6,
      "tight": 1.3,
      "heading": 1.2
    },
    "letterSpacing": {
      "label": "0.08em"
    }
  },
  "spacing": {
    "_note": "Feed spacing scale (--feed-space-*). 48/64/80 grow at 1280px and up (see responsive).",
    "scale": {
      "4": {
        "rem": "0.25rem",
        "px": 4
      },
      "8": {
        "rem": "0.5rem",
        "px": 8
      },
      "12": {
        "rem": "0.75rem",
        "px": 12
      },
      "16": {
        "rem": "1rem",
        "px": 16
      },
      "24": {
        "rem": "1.5rem",
        "px": 24
      },
      "32": {
        "rem": "2rem",
        "px": 32
      },
      "40": {
        "rem": "3rem",
        "px": 48
      },
      "48": {
        "rem": "3.5rem",
        "px": 56
      },
      "64": {
        "rem": "5rem",
        "px": 80
      },
      "80": {
        "rem": "6rem",
        "px": 96
      }
    },
    "page": {
      "px": {
        "base": "1rem",
        "600": "1.5rem",
        "960": "2rem",
        "1280": "3rem"
      },
      "py": {
        "base": "2rem",
        "960": "3rem"
      },
      "cssVars": [
        "--feed-page-px",
        "--feed-page-py"
      ]
    }
  },
  "layout": {
    "maxWidth": {
      "rem": "85rem",
      "px": 1360
    },
    "railWidth": {
      "rem": "16.25rem",
      "px": 260
    },
    "feedGap": {
      "rem": "4rem",
      "px": 64
    },
    "panelWidth": {
      "rem": "47.5rem",
      "px": 760,
      "cssVar": "--feed-panel-w"
    }
  },
  "border": {
    "width": "1px",
    "color": "#2a2a22",
    "colorSubtle": "rgba(255,255,255,0.06)",
    "default": "1px solid #2a2a22",
    "card": "1px solid #2a2a22",
    "rule": "1px solid rgba(255,255,255,0.08)",
    "_note": "Light, subtle borders matching staging dark mode"
  },
  "radius": {
    "sm": {
      "rem": "0.5rem",
      "px": 8,
      "_staging": "card border-radius"
    },
    "md": {
      "rem": "0.75rem",
      "px": 12
    },
    "lg": {
      "rem": "2.8125rem",
      "px": 45
    },
    "pill": {
      "px": 999,
      "_staging": "chip border-radius: 999px"
    }
  },
  "shadow": {
    "sm": "0 1px 4px rgba(0,0,0,0.2)",
    "md": "0 4px 16px rgba(0,0,0,0.08)",
    "lift": {
      "dark": "0 12px 32px rgba(0,0,0,0.5), 0 2px 6px rgba(0,0,0,0.3)",
      "light": "0 12px 32px rgba(0,0,0,0.12), 0 2px 6px rgba(0,0,0,0.06)",
      "cssVar": "--feed-shadow-lift",
      "use": "Raised, focused element (open team card and panel)"
    }
  },
  "components": {
    "button": {
      "small": {
        "fontSize": "0.75rem",
        "padding": "0.5rem 1.125rem",
        "borderRadius": "999px",
        "border": "1px solid #dddddd"
      }
    },
    "chip": {
      "fontSize": "0.8125rem",
      "fontWeight": 400,
      "padding": "0.5rem 1rem",
      "borderRadius": "999px",
      "bgActive": "var(--feed-text)",
      "borderDefault": "none",
      "bgDefault": "var(--feed-raised)",
      "bgHover": "var(--feed-border)",
      "textActive": "var(--feed-bg)"
    },
    "card": {
      "borderRadius": "0.5rem",
      "bodyPadding": "14px 16px 16px",
      "bodyGap": "8px",
      "border": "1px solid #2a2a22",
      "background": "#1b1b17"
    },
    "carousel": {
      "gap": "16px",
      "padding": "0 32px 16px",
      "_staging": "carousel: 16px gap / 0 32px 16px pad"
    },
    "cardTags": {
      "fontSize": "0.75rem",
      "color": "var(--feed-blue)",
      "moreColor": "var(--feed-text-dim)",
      "maxVisible": 4,
      "gap": "0.25rem 0.5rem"
    },
    "promo": {
      "thumbAspect": "16 / 10",
      "thumbMaxWidth": "240px",
      "button": {
        "fontSize": "0.9375rem",
        "padding": "0.5rem 1rem",
        "border": "1px solid currentColor",
        "borderRadius": "999px"
      }
    },
    "teamProfile": {
      "grid": "4 columns at 1280px+, 3 at 960px+, 2 at 600px+, 1 below; gap 1rem",
      "card": "surface background, 1px border, radius 0.5rem, square photo, body padding 14px 16px 16px, +/- indicator",
      "openCard": "border transparent, --feed-shadow-lift, translateY(-2px); other cards opacity 0.45 and grayscale(0.6)",
      "panel": "box up to --feed-panel-w, centred under the open card within the grid, --feed-shadow-lift, no border, 12px notch; header (name at --feed-fs-h2, role, close), bio beside a compact post list (dates right-aligned, rule between), footer with LinkedIn and see-all"
    }
  },
  "breakpoints": {
    "mobile": {
      "maxWidth": "599px"
    },
    "tablet": {
      "minWidth": "600px",
      "maxWidth": "959px"
    },
    "desktop": {
      "minWidth": "960px"
    }
  },
  "motion": {
    "transition": "200ms ease",
    "transitionSlow": "300ms ease",
    "cssVars": [
      "--feed-transition",
      "--feed-transition-slow"
    ]
  },
  "responsive": {
    "_note": "Overrides at min-width 1280px (feed.css)",
    "minWidth": "1280px",
    "fontSize": {
      "body": "1rem",
      "cardExcerpt": "0.9375rem",
      "cardMeta": "0.875rem",
      "cardTitle": "1.25rem",
      "feedH2": "1.5rem",
      "feedH1": "2.5rem",
      "hero": "3rem"
    },
    "spacing": {
      "48": "4rem",
      "64": "6rem",
      "80": "8rem"
    }
  }
}
