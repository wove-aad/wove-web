  "components": {
    "button": {
      "source": "assets/css/site.css",
      "description": "The one button. .btn plus a colourway: --primary (black), --ghost (outlined) or --inverse (white, on dark grounds). Add .btn--sm for the header \"Get in touch\".",
      "rules": {
        ".btn": {
          "display": "inline-flex",
          "align-items": "center",
          "justify-content": "center",
          "gap": "var(--space-12)",
          "padding": "var(--space-16) var(--space-24)",
          "border": "1px solid transparent",
          "border-radius": "var(--radius-pill)",
          "font-family": "var(--font)",
          "font-size": "var(--size-nav)",
          "font-weight": "var(--weight-bold)",
          "line-height": "1.5",
          "white-space": "nowrap",
          "text-decoration": "none",
          "cursor": "pointer",
          "transition": "background-color var(--transition), color var(--transition), border-color var(--transition), opacity var(--transition)"
        },
        ".btn--sm": {
          "padding": "0.5rem 1.25rem",
          "min-height": "2.75rem"
        },
        ".btn.btn--primary": {
          "background": "var(--color-black)",
          "color": "var(--color-white)"
        },
        ".btn.btn--primary:hover": {
          "opacity": "0.85",
          "text-decoration": "none"
        },
        ".btn.btn--ghost": {
          "background": "transparent",
          "color": "var(--color-black)",
          "border-color": "var(--color-black)"
        },
        ".btn.btn--ghost:hover": {
          "background": "var(--color-black)",
          "color": "var(--color-white)",
          "text-decoration": "none"
        },
        ".btn.btn--inverse": {
          "background": "var(--color-white)",
          "color": "var(--color-black)"
        },
        ".btn.btn--inverse:hover": {
          "opacity": "0.85",
          "text-decoration": "none"
        }
      }
    },
    "filterPill": {
      "source": "assets/css/feed.css",
      "description": "Topic filter pill. home.css sets 16px text and 12px 24px padding inside .topic-pills.",
      "rules": {
        ".tag-pill": {
          "font-family": "var(--feed-ff)",
          "font-size": "var(--feed-fs-chip)",
          "font-weight": "var(--feed-fw-regular)",
          "color": "var(--feed-text-muted)",
          "background": "var(--feed-raised)",
          "border": "none",
          "border-radius": "var(--feed-radius-pill)",
          "padding": "var(--feed-space-8) var(--feed-space-16)",
          "cursor": "pointer",
          "text-decoration": "none",
          "transition": "background-color var(--feed-transition), color var(--feed-transition)"
        },
        ".tag-pill:hover": {
          "background": "var(--feed-border)",
          "color": "var(--feed-text)"
        },
        ".tag-pill.is-active": {
          "background": "var(--feed-text)",
          "color": "var(--feed-bg)"
        }
      }
    },
    "tag": {
      "source": "assets/css/site.css",
      "description": "Non-interactive tag.",
      "rules": {
        ".tag": {
          "background": "var(--color-white)",
          "color": "var(--color-black)",
          "font-size": "var(--size-p4)",
          "line-height": "var(--lh-p4)",
          "padding": "0.5rem 1.25rem",
          "border-radius": "var(--radius-pill)",
          "border": "var(--border)"
        }
      }
    }
  },
  "fontFiles": {
    "_note": "Ballinger files in assets/fonts (woff2 + woff), declared in site.css. There are no files for 300, 500 or 900; those weights fall back to the nearest one.",
    "400": "Ballinger-Regular",
    "400italic": "Ballinger-Italic",
    "700": "Ballinger-Bold",
    "800": "Ballinger-X-Bold"
  },
  "breakpoints": {
    "_note": "The widths the CSS uses. Most rules are desktop-first (max-width); the feed scopes are mobile-first (min-width).",
    "phone": "max-width: 600px",
    "tablet": "max-width: 960px",
    "feedSmall": "min-width: 600px",
    "feedMedium": "min-width: 960px",
    "feedWide": "min-width: 1280px"
  },
  "a11yNotes": {
    "textMuted": "Uses #555555 (color-700). Passes WCAG AA on white (7.46:1). Former #a0a0a0 and #777777 (color-600) both fail AA.",
    "offWhite": "#f9f9f9 used for section backgrounds and card fills",
    "coral": "#ed8c7c used for the Get in touch nav CTA. Black text on coral passes AA (5.28:1).",
    "aqua": "#d5faff used as illustration/service card background accent. Decorative only."
  }
}
