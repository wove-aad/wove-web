  "_meta": {
    "project": "Wove.group",
    "about": "Generated from the site CSS by scripts/build-tokens.py. Do not edit the scopes or components by hand: change the CSS, then run the script. fontFiles, breakpoints and a11yNotes are written by hand and kept.",
